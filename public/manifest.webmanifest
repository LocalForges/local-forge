{
  "name": "LocalForge · 本地文件工具箱",
  "short_name": "LocalForge",
  "description": "纯浏览器端的本地文件工具箱：压缩、解压、格式转换、媒体转码、PDF 处理、二维码、OCR。全部在本地完成，文件不出设备。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070b14",
  "theme_color": "#0f172a",
  "categories": ["utilities", "productivity", "photo"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "压缩为 ZIP", "short_name": "压缩", "url": "/zip-compress" },
    { "name": "图片工具", "short_name": "图片", "url": "/image-convert" },
    { "name": "二维码工具箱", "short_name": "二维码", "url": "/qr-code" },
    { "name": "OCR 文字识别", "short_name": "OCR", "url": "/ocr" }
  ]
}
